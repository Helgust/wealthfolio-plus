{
  "id": "planificador-es",
  "name": "Planificador ES",
  "version": "1.0.0",
  "description": "Испанский финансовый планировщик: IRPF, RETA, проекции",
  "author": "helgust",
  "main": "dist/addon.js",
  "sdkVersion": "3.8.0",
  "minWealthfolioVersion": "3.8.0",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "planificador-es"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "planificador-es",
          "route": "planificador-es",
          "label": "Planificador ES",
          "icon": "calculator",
          "order": 100
        }
      ]
    }
  },
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.8.0",
    "@wealthfolio/ui": "^3.8.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": [
        "getAll"
      ],
      "purpose": "Стартовые балансы плана: список счетов"
    },
    {
      "category": "portfolio",
      "functions": [
        "getHoldings",
        "getHistoricalValuations",
        "getIncomeSummary",
        "getAlternativeHoldings"
      ],
      "purpose": "Позиции с лотами FIFO, история стоимости, доходы, недвижимость и долги для проекции"
    }
  ],
  "keywords": [
    "wealthfolio",
    "addon"
  ],
  "license": "AGPL-3.0"
}
