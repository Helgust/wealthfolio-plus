{
  "id": "planificador-es",
  "name": "Planificador ES",
  "version": "1.0.0",
  "description": "Spanish financial planner: IRPF, RETA, projections",
  "author": "helgust",
  "main": "dist/addon.js",
  "sdkVersion": "3.8.0",
  "minWealthfolioVersion": "3.8.0",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "planificador-es"
      },
      {
        "id": "planificador-es-compare"
      },
      {
        "id": "planificador-es-checks"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "planificador-es",
          "route": "planificador-es",
          "label": "Planificador ES",
          "icon": "calculator",
          "order": 100
        },
        {
          "id": "planificador-es-compare",
          "route": "planificador-es-compare",
          "label": "Compare plans",
          "icon": "scales",
          "order": 101
        }
      ]
    }
  },
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.8.0",
    "@wealthfolio/ui": "^3.8.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": [
        "getAll"
      ],
      "purpose": "Plan starting point: list of accounts"
    },
    {
      "category": "portfolio",
      "functions": [
        "getHoldings",
        "getHolding",
        "getHistoricalValuations",
        "getLatestValuations",
        "getIncomeSummary",
        "getAlternativeHoldings",
        "getNetWorth"
      ],
      "purpose": "Starting net worth and cash, FIFO lots, valuation history, income, property and debts for projections"
    }
  ],
  "keywords": [
    "wealthfolio",
    "addon"
  ],
  "license": "AGPL-3.0"
}
