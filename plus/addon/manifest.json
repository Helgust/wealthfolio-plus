{
  "id": "planificador-es",
  "name": "Planificador ES",
  "version": "1.0.0",
  "description": "Spanish financial planner: IRPF, RETA, projections",
  "author": "helgust",
  "main": "dist/addon.js",
  "sdkVersion": "3.8.0",
  "minWealthfolioVersion": "3.8.0",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "planificador-es"
      },
      {
        "id": "planificador-es-compare",
        "path": "compare"
      },
      {
        "id": "planificador-es-budget",
        "path": "budget"
      },
      {
        "id": "planificador-es-checks",
        "path": "checks"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "planificador-es",
          "route": "planificador-es",
          "label": "Planificador ES",
          "icon": "calculator",
          "order": 100
        },
        {
          "id": "planificador-es-compare",
          "route": "planificador-es-compare",
          "label": "Compare plans",
          "icon": "scales",
          "order": 101
        },
        {
          "id": "planificador-es-budget",
          "route": "planificador-es-budget",
          "label": "Budget",
          "icon": "wallet",
          "order": 102
        }
      ]
    }
  },
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.8.0",
    "@wealthfolio/ui": "^3.8.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": [
        "getAll"
      ],
      "purpose": "Plan starting point: list of accounts"
    },
    {
      "category": "portfolio",
      "functions": [
        "getHoldings",
        "getHolding",
        "getHistoricalValuations",
        "getLatestValuations",
        "getIncomeSummary",
        "getNetWorth"
      ],
      "purpose": "Starting net worth and cash, FIFO lots, valuation history (also budget plan vs fact by month) and income for projections"
    },
    {
      "category": "alternative-assets",
      "functions": [
        "getAll"
      ],
      "purpose": "Property and debts for projections"
    },
    {
      "category": "quotes",
      "functions": [
        "getHistory"
      ],
      "purpose": "Budget: what is owed on a linked liability at the end of each month"
    },
    {
      "category": "financial-planning",
      "functions": [
        "getAll",
        "update"
      ],
      "purpose": "Budget: fill targets from goals, and the month a goal is reached as its target date"
    },
    {
      "category": "spending",
      "functions": [
        "getCategories",
        "getReport"
      ],
      "purpose": "Budget: monthly averages by category as a draft of incomes and expenses"
    },
    {
      "category": "activities",
      "functions": [
        "saveTransferPair"
      ],
      "purpose": "Budget: record a month's envelope deposits as transfers, after you confirm them"
    }
  ],
  "keywords": [
    "wealthfolio",
    "addon"
  ],
  "license": "AGPL-3.0"
}
